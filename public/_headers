# Allow same-origin embeds plus JoinMyPDF Device Preview (and local Next ports).
# Prefer CSP frame-ancestors (multi-origin) — do not set X-Frame-Options here.
# CORP cross-origin lets JoinMyPDF pages with COEP: require-corp load us in an iframe.
/*
  Content-Security-Policy: frame-ancestors 'self' https://joinmypdf.com https://www.joinmypdf.com http://localhost:3000 http://localhost:3001 http://127.0.0.1:3000 http://127.0.0.1:3001
  Cross-Origin-Resource-Policy: cross-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Fingerprinted Next build assets — immutable long cache for repeat visits.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Site static assets (search CSS/JS, vendor).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Share / marketing images.
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Icons and brand marks (may update without hash — one-day cache).
/icons/*
  Cache-Control: public, max-age=86400
/icon.svg
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
