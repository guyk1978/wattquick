{
  "name": "wattquick",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "build:joinmypdf": "node scripts/build.mjs",
    "preview": "npx serve@14 out",
    "lint": "eslint .",
    "generate:calculators": "tsx scripts/generate-calculators-md.ts",
    "search:build": "node scripts/build-search-index.js",
    "fuse:vendor": "esbuild node_modules/fuse.js/dist/fuse.min.mjs --format=iife --global-name=Fuse --outfile=assets/js/vendor/fuse.min.js --minify --footer:js=\"if(typeof Fuse!=='undefined'&&typeof Fuse.default==='function'){Fuse=Fuse.default;}\"",
    "prebuild": "npm run generate:calculators && npm run search:build",
    "predev": "npm run generate:calculators && npm run search:build"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@cloudflare/next-on-pages": "^1.13.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.16.0",
    "next": "15.5.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "fuse.js": "^7.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
